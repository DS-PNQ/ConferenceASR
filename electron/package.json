{
  "name": "conflive",
  "version": "1.0.0",
  "description": "ConfLive desktop client (Electron + TypeScript) for the Python conference ASR backend",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run build:ui && tsc",
    "build:ui": "npm --prefix ui run build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "typescript": "^5.6.0",
    "electron-builder": "^26.0.0",
    "@types/node": "^22.0.0"
  },
  "build": {
    "appId": "com.conflive.app",
    "productName": "ConfLive",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "files": [
      "dist/**/*",
      "ui/dist/index.html",
      "package.json",
      "build/icon.png"
    ]
  }
}
