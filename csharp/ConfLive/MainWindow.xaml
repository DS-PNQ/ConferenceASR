<Window x:Class="ConfLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConfLive — Conference ASR + Translator" Height="780" Width="1200"
        MinHeight="640" MinWidth="980" Background="#F2F2F7" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="Purple" Color="#7C3AED"/>
    <SolidColorBrush x:Key="PurpleDark" Color="#6D28D9"/>
    <SolidColorBrush x:Key="PurpleSoft" Color="#EDE9FE"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ink" Color="#1C1917"/>
    <SolidColorBrush x:Key="Muted" Color="#78716C"/>
    <SolidColorBrush x:Key="SecondaryFill" Color="#E9E9EE"/>
    <SolidColorBrush x:Key="TrBg" Color="#F5F5F4"/>
    <!-- Primary action: the only filled-accent control on screen -->
    <Style x:Key="PrimaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#7C3AED"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="8,10"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#6D28D9"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#C7C7CC"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Secondary actions: quiet system-gray fills, no outlines -->
    <Style x:Key="SecondaryBtn" TargetType="Button">
      <Setter Property="Background" Value="#E9E9EE"/>
      <Setter Property="Foreground" Value="#1C1917"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Padding" Value="8,8"/>
      <Setter Property="Margin" Value="0,3"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#DEDEE5"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Foreground" Value="#8E8E93"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <!-- Section headers: small, gray, weight-based hierarchy -->
    <Style x:Key="SideLabel" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="#8E8E93"/>
      <Setter Property="Margin" Value="0,14,0,4"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <ScrollViewer Grid.Column="0" Background="White" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="18,18,18,18">
        <TextBlock Text="●  ConfLive" FontSize="22" FontWeight="Bold" Foreground="#1C1917"/>
        <TextBlock Text="Zipformer zh-en-vi · Hy-MT2 FP8" FontSize="12" Foreground="#78716C"/>
        <Border Background="#EDE9FE" CornerRadius="8" Padding="8,6" Margin="0,12,0,4">
          <TextBlock x:Name="DeviceBadge" Text="device: …" FontSize="12" Foreground="#7C3AED" TextWrapping="Wrap"/>
        </Border>

        <TextBlock Text="Microphone" Style="{StaticResource SideLabel}"/>
        <ComboBox x:Name="MicBox" />
        <TextBlock Text="Spoken language" Style="{StaticResource SideLabel}"/>
        <ComboBox x:Name="SrcBox" SelectedIndex="0">
          <ComboBoxItem Content="auto-detect"/>
          <ComboBoxItem Content="Tiếng Việt"/>
          <ComboBoxItem Content="English"/>
          <ComboBoxItem Content="中文"/>
        </ComboBox>
        <TextBlock Text="Translate to" Style="{StaticResource SideLabel}"/>
        <StackPanel Orientation="Horizontal">
          <CheckBox x:Name="CbEn" Content="EN" IsChecked="True" Margin="0,0,10,0"/>
          <CheckBox x:Name="CbZh" Content="中文" IsChecked="True" Margin="0,0,10,0"/>
          <CheckBox x:Name="CbVi" Content="VI"/>
        </StackPanel>
        <CheckBox x:Name="DenoiseBox" Content="🔇 DeepFilterNet denoise" IsChecked="True" Margin="0,12,0,0"/>
        <TextBlock x:Name="ModelText" FontSize="11" Foreground="#78716C" TextWrapping="Wrap" Margin="0,6,0,0"/>

        <Button x:Name="BtnRecord" Content="●  Record" Height="40" Margin="0,14,0,0"
                Style="{StaticResource PrimaryBtn}" Click="OnRecord"/>
        <Button x:Name="BtnStop" Content="■  Stop" Height="36" IsEnabled="False"
                Style="{StaticResource SecondaryBtn}" Click="OnStop"/>
        <UniformGrid Columns="2" Margin="0,4,0,0">
          <Button Content="⇪ Upload" Style="{StaticResource SecondaryBtn}" Margin="0,3,2,3" Click="OnUpload"/>
          <Button Content="Load models" Style="{StaticResource SecondaryBtn}" Margin="2,3,0,3" Click="OnWarmup"/>
        </UniformGrid>
        <UniformGrid Columns="3">
          <Button Content=".txt" Style="{StaticResource SecondaryBtn}" Margin="0,3,2,3" Click="OnExportTxt"/>
          <Button Content=".srt" Style="{StaticResource SecondaryBtn}" Margin="2,3,2,3" Click="OnExportSrt"/>
          <Button Content="Clear" Style="{StaticResource SecondaryBtn}" Margin="2,3,0,3" Click="OnClear"/>
        </UniformGrid>
        <TextBlock x:Name="StatusText" Text="…" FontSize="12" Foreground="#78716C"
                   TextWrapping="Wrap" Margin="0,10,0,0"/>
      </StackPanel>
    </ScrollViewer>

    <!-- Main -->
    <Grid Grid.Column="1" Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,4,0,12">
        <TextBlock Text="Live transcript" FontSize="28" FontWeight="SemiBold" Foreground="#1C1917"/>
        <TextBlock x:Name="CountText" Text="0 utterances" FontSize="13" Foreground="#78716C" Margin="12,0,0,0" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="LiveText" Text="● LIVE" FontSize="13" FontWeight="SemiBold" Foreground="#16A34A" Margin="8,0,0,0" VerticalAlignment="Bottom" Visibility="Collapsed"/>
      </DockPanel>
      <ScrollViewer x:Name="FeedScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    Background="Transparent" BorderThickness="0">
        <StackPanel x:Name="Feed" Margin="4"/>
      </ScrollViewer>
      <DockPanel Grid.Row="2" Margin="0,10,0,0">
        <ProgressBar x:Name="Meter" Height="10" Minimum="0" Maximum="1" Value="0" Foreground="#7C3AED" Background="#E7E5E4" BorderThickness="0"/>
        <TextBlock x:Name="MeterText" Text="mic idle" Width="110" FontSize="12" Foreground="#78716C" Margin="10,0,0,0" VerticalAlignment="Center"/>
      </DockPanel>
    </Grid>
  </Grid>
</Window>
